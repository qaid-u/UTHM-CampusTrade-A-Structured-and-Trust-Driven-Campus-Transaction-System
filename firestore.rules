rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // User profiles are readable by signed-in users for marketplace identity.
    // App-side flows also update profile, subscription, token, and trust fields.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Marketplace listings are created and managed by authenticated users.
    // App-side flows update fields such as status, isBoosted, and boostedAt.
    match /items/{itemId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Offers and transactions are fully controlled by the app UI/services.
    match /offers/{offerId} {
      allow read, create, update, delete: if signedIn();
    }

    match /transactions/{transactionId} {
      allow read, create, update, delete: if signedIn();
    }

    // Chat rooms and messages are created/updated from the application.
    match /chatRooms/{roomId} {
      allow read, create, update, delete: if signedIn();

      match /messages/{messageId} {
        allow read, create, update, delete: if signedIn();
      }
    }

    // Reviews stay anonymous and write-once:
    // document ID format is {transactionId}_{reviewerId}.
    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if false;
    }

    // Notifications and app config are used by client-side app flows.
    match /notifications/{notificationId} {
      allow read, create, update, delete: if signedIn();
    }

    match /config/{configId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }
  }
}
